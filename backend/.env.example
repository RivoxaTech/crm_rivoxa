APP_NAME="Rivoxa CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Karachi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=single
LOG_LEVEL=debug

# MySQL (XAMPP / Laragon defaults: user root, empty password). Edit if yours differ.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rivoxa_crm
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=720
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Admin login (created by rivoxa:install)
ADMIN_EMAIL=admin@rivoxa.tech
ADMIN_PASSWORD=

# Outgoing email (only needed for "Send by email")
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=invoices@yourdomain.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=invoices@yourdomain.com
MAIL_FROM_NAME="Rivoxa"
